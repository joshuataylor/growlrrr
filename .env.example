# Copy to .env and fill in your values.
# Used by scripts/bundle.sh and the `make notarize` target.

# Apple Developer team -- used to construct the codesign identity:
#   "Developer ID Application: $TEAM_NAME ($TEAM_ID)"
TEAM_NAME="Your Team Name"
TEAM_ID="ABCDE12345"

# Self-signed code-signing identity (fallback when no Developer ID above).
# release.sh signs the release bundle with a self-signed certificate of this
# common name, creating and trusting one in your keychain if it doesn't exist.
# Gives the app a stable signing identity across rebuilds without an Apple
# Developer account. Ignored when TEAM_NAME/TEAM_ID are set.
# SELF_SIGN_IDENTITY="growlrrr Self-Signed"
